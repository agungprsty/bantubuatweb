# Salin ke .env (lokal) atau ~/app/.env di VPS (chmod 600).

# Lokasi file SQLite. Lokal: biarkan kosong (pakai .data/dev.db).
# Production wajib: /var/lib/bantubuat/app.db (app menolak start jika kosong)
NUXT_DB_PATH=

# Minimal 32 karakter: openssl rand -hex 32
NUXT_SESSION_PASSWORD=

NUXT_ADMIN_EMAIL=
# read -rs PW && printf '%s' "$PW" | node scripts/hash-password.mjs && unset PW
NUXT_ADMIN_PASSWORD_HASH=
